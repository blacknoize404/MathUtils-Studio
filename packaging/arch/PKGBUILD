# Maintainer: blacknoize404 <https://github.com/blacknoize404>
#
# MathUtils Studio para Arch Linux: empaqueta el .tar.gz de Linux de cada release (la aplicación ya lleva su propio
# runtime de Java, recortado con jlink). pkgver y la suma las actualiza el flujo de GitHub Actions al publicar una
# release; también sirve para el AUR.
pkgname=mathutils-studio
pkgver=0.10.0
pkgrel=1
pkgdesc='Calculadora y solucionadores matemáticos paso a paso (derivadas, límites, integrales, matrices, estadística...)'
arch=('x86_64')
url='https://github.com/blacknoize404/MathUtils-Studio'
license=('LicenseRef-MathUtilsStudio')
depends=('gtk3' 'alsa-lib' 'libxtst' 'libxxf86vm' 'libxrender' 'libxi' 'libxext' 'libx11' 'libglvnd'
         'fontconfig' 'freetype2' 'pango' 'cairo' 'glib2' 'gdk-pixbuf2' 'atk' 'zlib')
# El runtime de Java va dentro y no se toca
options=('!strip' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/MathUtilsStudio-$pkgver-linux-x86_64.tar.gz"
        "LICENSE")
sha256sums=('d102cf3e1e9beeb2cdbf3290930ef23e2d71585d691d349bc6dd76150eee4731'
            '78259db52a9843be88ac6312fe91fc805b2fb6eacdca71779472953ace2a36e5')

package() {
  cd "$srcdir/MathUtilsStudio"

  install -dm755 "$pkgdir/opt/$pkgname" "$pkgdir/usr/bin"
  cp -r . "$pkgdir/opt/$pkgname"
  rm -f "$pkgdir/opt/$pkgname/install.sh" "$pkgdir/opt/$pkgname/mathutils-studio.desktop"
  ln -s "/opt/$pkgname/bin/MathUtilsStudio" "$pkgdir/usr/bin/mathutils-studio"

  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 mathutils-studio.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/mathutils-studio.svg"
  install -Dm644 lib/MathUtilsStudio.png "$pkgdir/usr/share/pixmaps/mathutils-studio.png"

  # El .desktop que trae la release lleva una ruta por rellenar: aquí se escribe el definitivo
  sed 's|@INSTALL_DIR@|/usr|; s|Exec=/usr/bin/MathUtilsStudio|Exec=mathutils-studio|' mathutils-studio.desktop 2>/dev/null \
    | install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/mathutils-studio.desktop"
}
